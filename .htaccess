# Gestión de Socios (PWA)
Options -Indexes
RewriteEngine On
# HTTPS siempre: el service worker y el bloqueo con huella solo funcionan con él.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType font/ttf .ttf
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Lo que decide la versión se pregunta siempre al servidor; lo demás lo guarda el service worker.
  <FilesMatch "^(sw\.js|version\.json|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(ttf|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json font/ttf
</IfModule>
