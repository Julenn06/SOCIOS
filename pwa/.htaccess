# Gestión de Socios (PWA)
Options -Indexes
RewriteEngine On
# HTTPS siempre: el service worker y el bloqueo con huella solo funcionan con él.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Un archivo compartido con la app lo recoge el service worker. Si aún no estaba activo, la petición llega aquí: se
# vuelve a la app, que avisa de que no ha llegado nada.
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^compartir$ /?accion=importar [L,R=303]

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType font/ttf .ttf
AddType font/woff2 .woff2
AddDefaultCharset utf-8

<IfModule mod_headers.c>
  # Lo que decide la versión se pregunta siempre al servidor; lo demás lo guarda el service worker.
  <FilesMatch "^(sw\.js|version\.json|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(ttf|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # Solo código y estilos de este sitio: aunque se colara un nombre o una nota con HTML (una copia manipulada, por
  # ejemplo), no podría ejecutar nada ni cambiar cómo se ve. Sin style="" en el HTML (clases o el.style) y, con Trusted
  # Types, todo HTML pasa por la política 'socios' (js/confianza.js). El hash es el del script del tema de index.html;
  # si se cambia ese script, hay que cambiarlo aquí (herramientas/version.mjs --comprobar avisa). Lo que bloquee se
  # cuenta al servidor (report-uri; ver servidor/errores.js), también si la app no llega a arrancar.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-CZRMwOlLGhc53FnkXQBTxjJDGISaezVi1UbowIMmOxE='; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://socios-api.jfl06studio.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types socios; upgrade-insecure-requests; report-uri https://socios-api.jfl06studio.com/api/errores"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json font/ttf
</IfModule>
