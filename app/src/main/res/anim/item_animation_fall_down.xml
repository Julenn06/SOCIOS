<?xml version="1.0" encoding="utf-8"?>
<!-- Entrada de cada fila: sube un poco desde abajo mientras aparece, y se posa con suavidad. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="420"
    android:interpolator="@interpolator/salida_suave"
    android:shareInterpolator="true">

    <translate
        android:fromYDelta="24%"
        android:toYDelta="0%" />

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <scale
        android:fromXScale="98%"
        android:fromYScale="98%"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="100%"
        android:toYScale="100%" />
</set>
