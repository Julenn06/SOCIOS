<?xml version="1.0" encoding="utf-8"?>
<!-- Luz y textura para poner encima de un fondo de color (cabeceras): un brillo radial en la esquina
     superior derecha, otro más tenue abajo a la izquierda y un grano muy fino. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.92"
                android:centerY="0"
                android:endColor="#00FFFFFF"
                android:gradientRadius="260dp"
                android:startColor="#29FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="1"
                android:endColor="#00FFFFFF"
                android:gradientRadius="200dp"
                android:startColor="#12FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_grano" />
</layer-list>
