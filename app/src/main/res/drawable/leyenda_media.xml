<?xml version="1.0" encoding="utf-8"?>
<!-- Muestra de la línea discontinua de la media del gráfico, para su leyenda. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1.5dp"
        android:color="@color/green_text_soft"
        android:dashGap="3dp"
        android:dashWidth="5dp" />
    <size
        android:width="18dp"
        android:height="8dp" />
</shape>
