<?xml version="1.0" encoding="utf-8"?>
<!-- Copias y exportación: pestañas Exportar / Importar, alcance en tarjetas y formatos como filas. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:id="@+id/contenidoExportImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/handle" />

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icono_degradado"
                android:elevation="3dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_backup"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_titulo"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:fontFamily="@font/geist_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/export_subtitulo"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrar"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Pestañas -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:checkedButton="@id/btnModoExportar"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoExportar"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export_pestana_exportar"
                app:icon="@drawable/ic_export"
                app:iconGravity="textStart"
                app:iconTint="@color/opcion_texto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModoImportar"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export_pestana_importar"
                app:icon="@drawable/ic_import"
                app:iconGravity="textStart"
                app:iconTint="@color/opcion_texto" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Exportar e importar ocupan el mismo sitio: al cambiar de pestaña uno se funde con el otro y el
             panel no cambia de alto (mide lo del más alto), así no da saltos ni se queda un instante vacío. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===== EXPORTAR ===== -->
            <LinearLayout
                android:id="@+id/contenedorExportar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Socios.Seccion"
                    android:text="@string/export_alcance_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/alcanceSemana"
                        layout="@layout/item_alcance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/alcanceElegir"
                        layout="@layout/item_alcance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/alcanceTodo"
                        layout="@layout/item_alcance"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    style="@style/Socios.Seccion"
                    android:text="@string/export_formato_label" />

                <include
                    android:id="@+id/formatoPdf"
                    layout="@layout/item_formato" />

                <include
                    android:id="@+id/formatoCsv"
                    layout="@layout/item_formato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/formatoJson"
                    layout="@layout/item_formato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ===== IMPORTAR ===== -->
            <LinearLayout
                android:id="@+id/contenedorImportar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/amber_container"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/amber_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="10dp"
                        app:drawableTint="@color/amber_text"
                        android:padding="14dp"
                        android:text="@string/import_aviso"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_info" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Socios.Seccion"
                    android:text="@string/import_archivo_label" />

                <include
                    android:id="@+id/importarJson"
                    layout="@layout/item_formato" />

                <include
                    android:id="@+id/importarCsv"
                    layout="@layout/item_formato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
