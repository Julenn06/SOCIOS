<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_amount_badge"
    android:backgroundTint="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/handle" />

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:importantForAccessibility="no"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_export"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_titulo"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_subtitulo"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Selector de Alcance -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/export_alcance_label"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAlcance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlcanceSemana"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/export_alcance_semana" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlcanceSeleccion"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_alcance_elegir" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlcanceHistorico"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_alcance_historico" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Botón Selección de Semanas Específicas -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnElegirSemanas"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        tools:text="📅 1 semana seleccionada (2026-W41)"
        android:textColor="@color/primary"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider" />

    <!-- SECCIÓN 1: EXPORTAR -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/export_seccion_exportar"
        android:contentDescription="@string/export_seccion_exportar_a11y"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_muted"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPdf"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/export_pdf"
                android:textColor="@color/blue_text"
                app:backgroundTint="@color/blue_container"
                app:icon="@drawable/ic_file"
                app:iconTint="@color/blue_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCsv"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:text="@string/export_csv"
                android:textColor="@color/green_text"
                app:backgroundTint="@color/green_container"
                app:icon="@drawable/ic_export"
                app:iconTint="@color/green_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportJson"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:text="@string/export_json"
                android:textColor="@color/orange_text"
                app:backgroundTint="@color/orange_container"
                app:icon="@drawable/ic_export"
                app:iconTint="@color/orange_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SECCIÓN 2: IMPORTAR -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/export_seccion_importar"
        android:contentDescription="@string/export_seccion_importar_a11y"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_muted"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportJson"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/import_json"
                app:icon="@drawable/ic_import" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportCsv"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:text="@string/import_csv"
                app:icon="@drawable/ic_import" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Cerrar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrar"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_close" />

</LinearLayout>
