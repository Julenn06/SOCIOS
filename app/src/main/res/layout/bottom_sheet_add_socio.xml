<?xml version="1.0" encoding="utf-8"?>
<!-- Alta o edición de un socio. Los botones van fijos abajo, fuera del scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    tools:targetApi="q">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAddSocio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenidoAddSocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Handle drag bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@color/handle" />

            <TextView
                android:id="@+id/tvTitleBottomSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_add_socio"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloSemana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                tools:text="Semana del 12–16 oct" />

            <!-- Cabecera con la ganancia: verde si está conseguido, ámbar si está pendiente -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <!-- El fondo (degradado y círculos de adorno) se pone desde código -->
                <LinearLayout
                    android:id="@+id/fondoHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/preview_ganancia_label"
                            android:textColor="#D9FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewBaseX2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@android:color/white"
                            android:textSize="38sp"
                            android:textStyle="bold"
                            tools:text="+40,00 €" />

                        <TextView
                            android:id="@+id/tvPreviewDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#E6FFFFFF"
                            android:textSize="13sp"
                            tools:text="Cuota de 20 € × 2" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPreviewEstadoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pastilla"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="✓ Conseguido" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cuota -->
            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/section_cuota_label" />

            <!-- Las cuotas de ImportesPredefinidos.CUOTAS y "Otro" se añaden desde código -->
            <GridLayout
                android:id="@+id/gridCuotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:columnCount="4" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomAmount"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_custom_amount"
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:startIconDrawable="@drawable/ic_euro"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Día -->
            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/section_dia_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiaLun"
                    style="@style/Socios.Opcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiaMar"
                    style="@style/Socios.Opcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiaMie"
                    style="@style/Socios.Opcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiaJue"
                    style="@style/Socios.Opcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiaVie"
                    style="@style/Socios.Opcion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Estado -->
            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/section_estado_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstadoHecho"
                    style="@style/Socios.TarjetaSeleccionable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/green_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/green_text_soft" />
                        </FrameLayout>

                        <TextView
                            style="@style/Socios.TituloFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/estado_conseguido" />

                        <TextView
                            style="@style/Socios.DescripcionFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_conseguido_detalle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstadoPendiente"
                    style="@style/Socios.TarjetaSeleccionable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/tarjeta_fondo_pendiente"
                    app:checkedIconTint="@color/orange_pending"
                    app:strokeColor="@color/tarjeta_borde_pendiente">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/orange_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_schedule"
                                app:tint="@color/orange_text" />
                        </FrameLayout>

                        <TextView
                            style="@style/Socios.TituloFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/estado_pendiente" />

                        <TextView
                            style="@style/Socios.DescripcionFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/estado_pendiente_detalle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Nombre y notas, plegados porque son opcionales -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Socios.TarjetaFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/filaDetalles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icono_tile"
                            android:backgroundTint="@color/blue_container">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_person"
                                app:tint="@color/blue_text_soft" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Socios.TituloFila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/detalles_titulo" />

                            <TextView
                                android:id="@+id/tvDetallesResumen"
                                style="@style/Socios.DescripcionFila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/detalles_opcional" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivDetallesFlecha"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/text_sub" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contenedorDetalles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="14dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_nombre_socio"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:startIconDrawable="@drawable/ic_person">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNombreSocio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/hint_notas"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:startIconDrawable="@drawable/ic_notes">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNotas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botones fijos: misma altura y alineados -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarAdd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_cancel"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarSocio"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1.6"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_save_socio"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
