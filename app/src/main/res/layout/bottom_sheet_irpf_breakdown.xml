<?xml version="1.0" encoding="utf-8"?>
<!-- Desglose de la semana: el neto y cómo se reparte el bruto, la cuenta paso a paso y los ajustes de la semana. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_verde">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_receipt" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/irpf_titulo" />

                <TextView
                    android:id="@+id/tvBreakdownRangoSemana"
                    style="@style/Socios.SubtituloPanel"
                    tools:text="12–16 oct 2026" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarBreakdown"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- El neto, destacado, y cómo se reparte el bruto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvBreakdownNetoBigLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/irpf_neto_final"
                    android:textColor="@color/header_label_neto"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_medium" />

                <TextView
                    android:id="@+id/tvBreakdownNetoBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="44sp"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="44sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="424,01 €" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/tvBreakdownSociosCount"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="10 de 12 socios hechos" />

                    <TextView
                        android:id="@+id/tvBreakdownIrpfPastilla"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="IRPF 21,48 %" />
                </com.google.android.material.chip.ChipGroup>

                <!-- El bruto repartido: lo que te llevas, el IRPF y lo descontado (si lo hay) -->
                <LinearLayout
                    android:id="@+id/contenedorReparto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/barraReparto"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_pastilla"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/segmentoNeto"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="80"
                            android:background="@android:color/white" />

                        <View
                            android:id="@+id/segmentoIrpf"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_weight="20"
                            android:background="@color/header_label_irpf" />

                        <View
                            android:id="@+id/segmentoDescontado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_weight="0"
                            android:background="@color/header_bonus"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="14dp"
                        app:chipSpacingVertical="4dp">

                        <TextView
                            android:id="@+id/tvLeyendaNeto"
                            style="@style/Socios.LeyendaReparto"
                            app:drawableTint="@android:color/white"
                            tools:text="Para ti 424,01 €" />

                        <TextView
                            android:id="@+id/tvLeyendaIrpf"
                            style="@style/Socios.LeyendaReparto"
                            app:drawableTint="@color/header_label_irpf"
                            tools:text="IRPF 115,99 €" />

                        <TextView
                            android:id="@+id/tvLeyendaDescontado"
                            style="@style/Socios.LeyendaReparto"
                            android:visibility="gone"
                            app:drawableTint="@color/header_bonus"
                            tools:text="Descontado 15,31 €"
                            tools:visibility="visible" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- La cuenta, paso a paso -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/irpf_seccion_calculo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <include
                    android:id="@+id/pasoSuma"
                    layout="@layout/item_fila_desglose" />

                <include
                    android:id="@+id/pasoBase"
                    layout="@layout/item_fila_desglose" />

                <include
                    android:id="@+id/pasoBonus"
                    layout="@layout/item_fila_desglose" />

                <View
                    style="@style/Socios.SeparadorDesglose" />

                <include
                    android:id="@+id/pasoBruto"
                    layout="@layout/item_fila_desglose" />

                <include
                    android:id="@+id/pasoIrpf"
                    layout="@layout/item_fila_desglose" />

                <!-- Con lo cobrado apuntado: el neto calculado y lo que falta (o sobra) hasta lo cobrado -->
                <LinearLayout
                    android:id="@+id/contenedorBreakdownCobro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        style="@style/Socios.SeparadorDesglose" />

                    <include
                        android:id="@+id/pasoNetoCalculado"
                        layout="@layout/item_fila_desglose" />

                    <include
                        android:id="@+id/pasoDescontado"
                        layout="@layout/item_fila_desglose" />
                </LinearLayout>

                <!-- El resultado: el neto cobrado si está apuntado; si no, el que toca cobrar -->
                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/green_container"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_verde">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:text="@string/irpf_signo_igual"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:fontFamily="@font/geist_semibold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvBreakdownNetoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/irpf_total_neto"
                        android:textColor="@color/green_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/tvBreakdownNetoSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/green_text"
                        android:textSize="19sp"
                        android:fontFamily="@font/geist_semibold"
                        tools:text="424,01 €" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lo cobrado y el porcentaje de IRPF -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/irpf_seccion_ajustes" />

        <include
            android:id="@+id/btnCobroBreakdown"
            layout="@layout/item_formato" />

        <include
            android:id="@+id/btnCambiarIrpf"
            layout="@layout/item_formato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <include
            android:id="@+id/btnVerCambiosIrpf"
            layout="@layout/item_formato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
