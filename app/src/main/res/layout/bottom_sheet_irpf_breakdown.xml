<?xml version="1.0" encoding="utf-8"?>
<!-- Desglose de la semana: neto a cobrar, cómo se calcula y cambios del porcentaje de IRPF. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_verde">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:src="@drawable/ic_receipt" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/irpf_titulo" />

                <TextView
                    android:id="@+id/tvBreakdownRangoSemana"
                    style="@style/Socios.SubtituloPanel"
                    tools:text="12–16 oct 2026" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarBreakdown"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Neto a cobrar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_verde"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvBreakdownNetoBigLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/irpf_neto_final"
                    android:textColor="#D9FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_medium" />

                <TextView
                    android:id="@+id/tvBreakdownNetoBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="40sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="424,01 €" />

                <TextView
                    android:id="@+id/tvBreakdownSociosCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pastilla"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="10 socios hechos de 12 registrados" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cómo se calcula -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/irpf_seccion_calculo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout style="@style/Socios.Fila">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/text_sub" />

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:text="@string/irpf_fila_suma" />

                    <TextView
                        android:id="@+id/tvBreakdownSumaCuotas"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="200,00 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="12dp">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/blue_text_soft" />

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:text="@string/irpf_fila_base" />

                    <TextView
                        android:id="@+id/tvBreakdownBaseX2"
                        style="@style/Socios.ImporteCalculo"
                        android:textColor="@color/blue_text_soft"
                        tools:text="+400,00 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="12dp">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/orange_pending" />

                    <TextView
                        android:id="@+id/tvBreakdownBonusLabel"
                        style="@style/Socios.EtiquetaCalculo"
                        tools:text="Bonus por 10 socios hechos" />

                    <TextView
                        android:id="@+id/tvBreakdownBonusValue"
                        style="@style/Socios.ImporteCalculo"
                        android:textColor="@color/orange_text"
                        tools:text="+140,00 €" />
                </LinearLayout>

                <!-- Motivo del bonus manual, si se indicó -->
                <TextView
                    android:id="@+id/tvBreakdownBonusNota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_sub"
                    android:textSize="12.5sp"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:text="«Regalo de la jefa por buen trabajo»"
                    tools:visibility="visible" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Socios.Fila">

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:layout_marginStart="0dp"
                        android:text="@string/irpf_total_bruto"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/tvBreakdownBruto"
                        style="@style/Socios.ImporteCalculo"
                        android:textSize="16sp"
                        tools:text="540,00 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="12dp">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/red_text" />

                    <TextView
                        android:id="@+id/tvBreakdownIrpfLabel"
                        style="@style/Socios.EtiquetaCalculo"
                        android:textColor="@color/red_text"
                        tools:text="Retención IRPF (21,48 %)" />

                    <TextView
                        android:id="@+id/tvBreakdownIrpf"
                        style="@style/Socios.ImporteCalculo"
                        android:textColor="@color/red_text"
                        tools:text="-115,99 €" />
                </LinearLayout>

                <!-- Con lo cobrado apuntado: el neto calculado y lo que falta (o sobra) hasta lo cobrado -->
                <LinearLayout
                    android:id="@+id/contenedorBreakdownCobro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/divider" />

                    <LinearLayout style="@style/Socios.Fila">

                        <TextView
                            style="@style/Socios.EtiquetaCalculo"
                            android:layout_marginStart="0dp"
                            android:text="@string/irpf_neto_calculado"
                            android:fontFamily="@font/geist_semibold" />

                        <TextView
                            android:id="@+id/tvBreakdownNetoCalculado"
                            style="@style/Socios.ImporteCalculo"
                            android:textSize="16sp"
                            tools:text="300,00 €" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Socios.Fila"
                        android:layout_marginTop="12dp">

                        <View
                            android:id="@+id/puntoBreakdownDescontado"
                            style="@style/Socios.PuntoCalculo"
                            android:backgroundTint="@color/red_text" />

                        <TextView
                            android:id="@+id/tvBreakdownDescontadoLabel"
                            style="@style/Socios.EtiquetaCalculo"
                            tools:text="Te han descontado" />

                        <TextView
                            android:id="@+id/tvBreakdownDescontado"
                            style="@style/Socios.ImporteCalculo"
                            android:textColor="@color/red_text"
                            tools:text="-15,31 €" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBreakdownCobroNota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_sub"
                        android:textSize="12.5sp"
                        android:textStyle="italic"
                        android:visibility="gone"
                        tools:text="«Devolución de la 2.ª cuota de Ana»"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Neto final, resaltado: el cobrado si está apuntado; si no, el que toca cobrar -->
                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/green_container"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvBreakdownNetoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/irpf_total_neto"
                        android:textColor="@color/green_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/tvBreakdownNetoSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green_text"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_semibold"
                        tools:text="424,01 €" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lo cobrado de verdad -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/irpf_seccion_cobro" />

        <include
            android:id="@+id/btnCobroBreakdown"
            layout="@layout/item_formato" />

        <!-- IRPF -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/irpf_seccion_porcentaje" />

        <include
            android:id="@+id/btnCambiarIrpf"
            layout="@layout/item_formato" />

        <include
            android:id="@+id/btnVerCambiosIrpf"
            layout="@layout/item_formato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
