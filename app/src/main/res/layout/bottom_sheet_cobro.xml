<?xml version="1.0" encoding="utf-8"?>
<!-- Lo cobrado de verdad en una semana: el neto que ha llegado, por qué no coincide y cuánto se ha descontado. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Handle drag bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/handle" />

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_icono_verde"
                android:elevation="3dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cobro"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cobro_titulo"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:fontFamily="@font/geist_semibold" />

                <TextView
                    android:id="@+id/tvSubtituloCobro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="19–23 oct 2026" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarCobro"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Para qué sirve -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_icono_tile"
            android:backgroundTint="@color/surface_muted"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/text_sub" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/cobro_explicacion"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/cobro_label_monto" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNetoCobrado"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cobro_hint_monto"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:helperTextEnabled="true"
            app:startIconDrawable="@drawable/ic_euro"
            tools:helperText="Calculado: 300,00 €">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNetoCobrado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_semibold"
                android:fontFeatureSettings="tnum"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:textSize="18sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cobro_hint_nota"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:startIconDrawable="@drawable/ic_notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotaCobro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cómo queda la semana con lo escrito -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/cobro_preview_titulo" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout style="@style/Socios.FilaCalculo">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/text_sub" />

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:text="@string/cobro_preview_calculado" />

                    <TextView
                        android:id="@+id/tvPreviewCalculado"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="300,00 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.FilaCalculo"
                    android:layout_marginTop="12dp">

                    <View
                        style="@style/Socios.PuntoCalculo"
                        android:backgroundTint="@color/primary" />

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:text="@string/cobro_preview_cobrado" />

                    <TextView
                        android:id="@+id/tvPreviewCobrado"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="284,69 €" />
                </LinearLayout>

                <!-- La diferencia: rojo si te han descontado, verde si coincide o has cobrado de más -->
                <LinearLayout
                    android:id="@+id/placaPreviewDiferencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/red_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvPreviewDiferenciaLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/red_text"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_semibold"
                        tools:text="Te han descontado" />

                    <TextView
                        android:id="@+id/tvPreviewDiferencia"
                        style="@style/Socios.Cifra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red_text"
                        android:textSize="18sp"
                        tools:text="-15,31 €" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones: misma altura y alineados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuitarCobro"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cobro_quitar"
                android:textColor="@color/red_text"
                android:textSize="15sp"
                android:fontFamily="@font/geist_semibold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/red_text"
                app:strokeColor="@color/stroke"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarCobro"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.4"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_save"
                android:textSize="15sp"
                android:fontFamily="@font/geist_semibold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
