<?xml version="1.0" encoding="utf-8"?>
<!-- Un dato del histórico ("Tu mejor día", "Cuota media"…): qué es y de dónde sale, y la cifra a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Socios.Fila"
    android:minHeight="56dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:focusable="true"
    android:screenReaderFocusable="true"
    tools:targetApi="28">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEstadisticaTitulo"
            style="@style/Socios.TituloFila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Tu mejor día" />

        <TextView
            android:id="@+id/tvEstadisticaDetalle"
            style="@style/Socios.DescripcionFila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            tools:text="28 % de los socios que has hecho" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEstadisticaValor"
        style="@style/Socios.Cifra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        tools:text="Martes" />
</LinearLayout>
