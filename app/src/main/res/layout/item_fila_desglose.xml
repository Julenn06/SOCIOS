<?xml version="1.0" encoding="utf-8"?>
<!--
    Un paso de la cuenta del desglose: placa de color con la operación (Σ, ×2, +, −, =), qué es, un detalle
    opcional debajo y el importe. Los colores y los textos los pone IrpfBreakdownBottomSheetDialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Socios.Fila"
    android:minHeight="52dp"
    android:paddingVertical="6dp">

    <FrameLayout
        android:id="@+id/placaPaso"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icono_tile"
        tools:backgroundTint="@color/blue_container">

        <TextView
            android:id="@+id/tvSignoPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="15sp"
            android:fontFamily="@font/geist_semibold"
            tools:text="×2"
            tools:textColor="@color/blue_text_soft" />
    </FrameLayout>

    <LinearLayout
        style="@style/Socios.ColumnaTextos"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tvTituloPaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="14.5sp"
            android:fontFamily="@font/geist_medium"
            tools:text="Base (cuotas × 2)" />

        <TextView
            android:id="@+id/tvDetallePaso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_sub"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="Haz 2 socios más para llegar a +50 €"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvImportePaso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textSize="15sp"
        android:fontFamily="@font/geist_semibold"
        tools:text="+74,00 €"
        tools:textColor="@color/blue_text_soft" />
</LinearLayout>
