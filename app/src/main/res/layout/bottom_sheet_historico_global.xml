<?xml version="1.0" encoding="utf-8"?>
<!-- Histórico: lo cobrado en todas las semanas, cómo va esta semana y el desglose por semanas, meses o años. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_degradado">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/historico_titulo" />

                <TextView
                    style="@style/Socios.SubtituloPanel"
                    android:text="@string/historico_subtitulo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarHistorico"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Totales: lo cobrado, destacado; cuánto del bruto se queda, y la base, el bonus y el IRPF -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_cobrado_label"
                    android:textColor="@color/header_label_neto"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_medium" />

                <TextView
                    android:id="@+id/tvGlobalNetoTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="44sp"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="44sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="8.060,93 €" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/tvGlobalSemanasCount"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="28 semanas" />

                    <TextView
                        android:id="@+id/tvGlobalMediaSemana"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="Media 287,89 € / semana" />
                </com.google.android.material.chip.ChipGroup>

                <!-- De todo lo ganado en bruto, qué parte llega a cobrarse -->
                <LinearLayout
                    android:id="@+id/contenedorParteBruto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Socios.Fila">

                        <TextView
                            android:id="@+id/tvGlobalParteBruto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@android:color/white"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/geist_medium"
                            tools:text="Te queda el 80 % del bruto" />

                        <TextView
                            android:id="@+id/tvGlobalBrutoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/header_label_base"
                            android:textSize="12.5sp"
                            tools:text="Bruto 10.044,14 €" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progresoParteBruto"
                        style="@style/Socios.BarraProporcion"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:progressBackgroundTint="@color/header_divider"
                        android:progressTint="@android:color/white"
                        tools:progress="800" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Socios.CajaCabecera"
                        android:layout_marginEnd="8dp">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/label_base_x2"
                            android:textColor="@color/header_label_base" />

                        <TextView
                            android:id="@+id/tvGlobalBaseTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            tools:text="+7.534 €" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Socios.CajaCabecera">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/historico_bonus_label"
                            android:textColor="@color/header_label_bonus" />

                        <TextView
                            android:id="@+id/tvGlobalBonusTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            android:textColor="@color/header_bonus"
                            tools:text="+2.510 €" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Socios.CajaCabecera"
                        android:layout_marginStart="8dp">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/historico_irpf_label"
                            android:textColor="@color/header_label_irpf" />

                        <TextView
                            android:id="@+id/tvGlobalIrpfTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            android:textColor="@color/header_irpf"
                            tools:text="-1.983,21 €" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Esta semana frente a la anterior, a la media y a la mejor -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/historico_seccion_comparativa" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    style="@style/Socios.Fila">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icono_tile"
                        android:backgroundTint="@color/green_container">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_today"
                            app:tint="@color/green_text" />
                    </FrameLayout>

                    <LinearLayout
                        style="@style/Socios.ColumnaTextos">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comparativa_neto_label"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvComparativaNeto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text_main"
                            android:textSize="26sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="59,94 €" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cajaComparativaAnterior"
                        style="@style/Socios.CajaComparativa"
                        android:layout_marginEnd="10dp">

                        <TextView
                            style="@style/Socios.EtiquetaComparativa"
                            android:text="@string/comparativa_vs_anterior" />

                        <TextView
                            android:id="@+id/tvComparativaAnterior"
                            style="@style/Socios.ImporteComparativa"
                            tools:text="↓ 17,82 €" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cajaComparativaMedia"
                        style="@style/Socios.CajaComparativa">

                        <TextView
                            android:id="@+id/tvComparativaMediaLabel"
                            style="@style/Socios.EtiquetaComparativa"
                            tools:text="Frente a tu media (27 semanas)" />

                        <TextView
                            android:id="@+id/tvComparativaMedia"
                            style="@style/Socios.ImporteComparativa"
                            tools:text="↓ 236,39 €" />
                    </LinearLayout>
                </LinearLayout>

                <!-- La mejor semana: al tocarla se abre -->
                <LinearLayout
                    android:id="@+id/filaMejorSemana"
                    style="@style/Socios.Fila"
                    android:layout_marginHorizontal="-8dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="56dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_tile"
                        android:backgroundTint="@color/amber_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trophy"
                            app:tint="@color/amber_text" />
                    </FrameLayout>

                    <LinearLayout
                        style="@style/Socios.ColumnaTextos">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comparativa_mejor"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:fontFamily="@font/geist_medium" />

                        <TextView
                            android:id="@+id/tvMejorSemanaRango"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_sub"
                            android:textSize="12.5sp"
                            tools:text="20–24 abr 2026" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMejorSemanaNeto"
                        style="@style/Socios.ImporteCalculo"
                        android:textColor="@color/amber_text"
                        android:textSize="16sp"
                        tools:text="565,34 €" />

                    <ImageView
                        android:id="@+id/ivMejorSemanaFlecha"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Desglose -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/historico_lista_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btnPorSemana"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorSemana"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_semana" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorMes"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_mes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorAnio"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_anio" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Evolución del neto, por semanas, meses o años según lo elegido arriba -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/historico_seccion_evolucion"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/grafico_ayuda"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <com.julen.socios.GraficoNetoView
                    android:id="@+id/graficoNeto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:focusable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotaAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/historico_nota_agrupacion"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSemanasHistoricas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_semana_historica" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
