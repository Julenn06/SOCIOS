<?xml version="1.0" encoding="utf-8"?>
<!-- Histórico: lo cobrado en todas las semanas, cómo va esta semana y el desglose por semanas, meses o años. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_degradado">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_history" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/historico_titulo" />

                <TextView
                    style="@style/Socios.SubtituloPanel"
                    android:text="@string/historico_subtitulo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarHistorico"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Totales: lo cobrado, destacado; cuánto del bruto se queda, y la base, el bonus y el IRPF -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_cobrado_label"
                    android:textColor="@color/header_label_neto"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_medium" />

                <TextView
                    android:id="@+id/tvGlobalNetoTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="44sp"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="44sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="8.060,93 €" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/tvGlobalSemanasCount"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="28 semanas" />

                    <TextView
                        android:id="@+id/tvGlobalMediaSemana"
                        style="@style/Socios.PastillaCabecera"
                        tools:text="Media 287,89 € / semana" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Socios.CajaCabecera"
                        android:layout_marginEnd="8dp">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/label_base_x2"
                            android:textColor="@color/header_label_base" />

                        <TextView
                            android:id="@+id/tvGlobalBaseTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            tools:text="+7.534 €" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Socios.CajaCabecera">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/historico_bonus_label"
                            android:textColor="@color/header_label_bonus" />

                        <TextView
                            android:id="@+id/tvGlobalBonusTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            android:textColor="@color/header_bonus"
                            tools:text="+2.510 €" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Socios.CajaCabecera"
                        android:layout_marginStart="8dp">

                        <TextView
                            style="@style/Socios.EtiquetaCajaCabecera"
                            android:text="@string/historico_irpf_label"
                            android:textColor="@color/header_label_irpf" />

                        <TextView
                            android:id="@+id/tvGlobalIrpfTotal"
                            style="@style/Socios.ImporteCajaCabecera"
                            android:textColor="@color/header_irpf"
                            tools:text="-1.983,21 €" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- La mejor semana, si hay alguna con neto: al tocarla se abre -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaMejorSemana"
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/amber_container"
            app:strokeColor="@color/amber_stroke">

            <LinearLayout
                android:id="@+id/filaMejorSemana"
                style="@style/Socios.Fila"
                android:background="?attr/selectableItemBackground"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icono_ambar">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_trophy"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    style="@style/Socios.ColumnaTextos">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comparativa_mejor"
                        android:textColor="@color/amber_text"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/tvMejorSemanaRango"
                        style="@style/Socios.TituloFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        tools:text="20–24 abr 2026" />

                    <TextView
                        android:id="@+id/tvMejorSemanaDetalle"
                        style="@style/Socios.DescripcionFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="13 socios hechos · +220 € bonus" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMejorSemanaNeto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/amber_text"
                    android:textSize="18sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="565,34 €" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/amber_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Desglose -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/historico_lista_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btnPorSemana"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorSemana"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_semana" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorMes"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_mes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorAnio"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_anio" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Evolución del neto, por semanas, meses o años según lo elegido arriba -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/historico_seccion_evolucion"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_semibold" />

                    <!-- Leyenda de la línea discontinua del gráfico -->
                    <TextView
                        android:id="@+id/tvGraficoMedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:drawablePadding="6dp"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textColor="@color/green_text_soft"
                        android:textSize="12sp"
                        android:fontFamily="@font/geist_semibold"
                        app:drawableStartCompat="@drawable/leyenda_media"
                        tools:text="Media 288 €" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGraficoAyuda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/grafico_ayuda"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <com.julen.socios.GraficoNetoView
                    android:id="@+id/graficoNeto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:focusable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotaAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/historico_nota_agrupacion"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSemanasHistoricas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_semana_historica" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
