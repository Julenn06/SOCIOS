<?xml version="1.0" encoding="utf-8"?>
<!-- Histórico: lo acumulado en todas las semanas y el desglose por semanas, meses o años. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_degradado">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:src="@drawable/ic_history" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/historico_titulo" />

                <TextView
                    style="@style/Socios.SubtituloPanel"
                    android:text="@string/historico_subtitulo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarHistorico"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Totales: el IRPF retenido destacado, y el neto y el bonus -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                                        android:text="@string/historico_irpf_label"
                    android:textColor="@color/header_label_irpf"
                    android:textSize="13sp"
                    android:fontFamily="@font/geist_medium" />

                <TextView
                    android:id="@+id/tvGlobalIrpfTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="40sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="-204,69 €" />

                <TextView
                    android:id="@+id/tvGlobalSemanasCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pastilla"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="En 3 semanas registradas" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_caja_translucida"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/historico_neto_label"
                            android:textColor="@color/header_label_base"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvGlobalNetoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="+748,31 €" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_caja_translucida"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/historico_bonus_label"
                            android:textColor="@color/header_label_bonus"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvGlobalBonusTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:textColor="@color/header_bonus"
                            android:textSize="15sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="+280,00 €" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_caja_translucida"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/historico_descontado_label"
                            android:textColor="@color/header_label_cobro"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvGlobalDescontadoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:textColor="@color/header_cobro"
                            android:textSize="15sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="-64,00 €" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Esta semana frente a la anterior, a la media y a la mejor -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/historico_seccion_comparativa" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvComparativaNeto"
                    style="@style/Socios.TituloFila"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Neto de esta semana: 298,38 €" />

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/Socios.EtiquetaCalculo"
                        android:layout_marginStart="0dp"
                        android:text="@string/comparativa_vs_anterior"
                        android:textColor="@color/text_sub" />

                    <TextView
                        android:id="@+id/tvComparativaAnterior"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="↓ 125,63 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvComparativaMediaLabel"
                        style="@style/Socios.EtiquetaCalculo"
                        android:layout_marginStart="0dp"
                        android:textColor="@color/text_sub"
                        tools:text="Frente a tu media (5 semanas)" />

                    <TextView
                        android:id="@+id/tvComparativaMedia"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="↑ 11,78 €" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <!-- La mejor semana: al tocarla se abre -->
                <LinearLayout
                    android:id="@+id/filaMejorSemana"
                    style="@style/Socios.Fila"
                    android:layout_marginHorizontal="-8dp"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="48dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_trophy"
                        app:tint="@color/amber_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/comparativa_mejor"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMejorSemanaRango"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_sub"
                            android:textSize="12.5sp"
                            tools:text="5–9 oct 2026" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMejorSemanaNeto"
                        style="@style/Socios.ImporteCalculo"
                        tools:text="424,01 €" />

                    <ImageView
                        android:id="@+id/ivMejorSemanaFlecha"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Desglose -->
        <TextView
            style="@style/Socios.Seccion"
            android:text="@string/historico_lista_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btnPorSemana"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorSemana"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_semana" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorMes"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_mes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPorAnio"
                style="@style/Socios.Opcion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/historico_por_anio" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Evolución del neto, por semanas, meses o años según lo elegido arriba -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null"
            app:cardBackgroundColor="@color/surface_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/historico_seccion_evolucion"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:fontFamily="@font/geist_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/grafico_ayuda"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

                <com.julen.socios.GraficoNetoView
                    android:id="@+id/graficoNeto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:focusable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotaAgrupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/historico_nota_agrupacion"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSemanasHistoricas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_semana_historica" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
