<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:forceDarkAllowed="false"
    android:orientation="vertical"
    android:padding="20dp"
    tools:targetApi="q">

    <!-- Handle drag bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/historico_titulo"
        android:contentDescription="@string/historico_titulo_a11y"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/historico_subtitulo"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <!-- Card IRPF Retenido Acumulado -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/red_container"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/red_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historico_irpf_label"
                android:textColor="@color/red_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGlobalIrpfTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/red_text_strong"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="-204,69 €" />

            <TextView
                android:id="@+id/tvGlobalSemanasCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/red_text"
                android:textSize="12sp"
                tools:text="Acumulado en 3 semanas de trabajo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Grid de Totales Acumulados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Total Neto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/green_container"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_neto_label"
                    android:textColor="@color/green_text_soft"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvGlobalNetoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/green_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="+748,31 €" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Total Bonus -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/amber_container"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historico_bonus_label"
                    android:textColor="@color/amber_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvGlobalBonusTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/orange_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="+280,00 €" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Encabezado de la lista y agrupación -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/historico_lista_label"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupAgrupacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPorSemana"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/historico_por_semana" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPorMes"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historico_por_mes" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPorAnio"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historico_por_anio" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvNotaAgrupacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/historico_nota_agrupacion"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSemanasHistoricas"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        tools:listitem="@layout/item_semana_historica" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarHistorico"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_close" />
</LinearLayout>
