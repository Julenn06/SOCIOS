<?xml version="1.0" encoding="utf-8"?>
<!-- Ajuste manual del bonus de una semana: sustituir o sumar al automático, importe y motivo. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:id="@+id/contenidoBono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Handle drag bar -->
        <View
            style="@style/Socios.AsaPanel" />

        <!-- Encabezado -->
        <LinearLayout
            style="@style/Socios.Fila">

            <FrameLayout
                style="@style/Socios.PlacaPanel"
                android:background="@drawable/bg_icono_ambar">

                <ImageView
                    style="@style/Socios.IconoPanel"
                    android:src="@drawable/ic_gift" />
            </FrameLayout>

            <LinearLayout
                style="@style/Socios.ColumnaTextos">

                <TextView
                    style="@style/Socios.TituloPanel"
                    android:text="@string/bono_titulo" />

                <TextView
                    android:id="@+id/tvSubtituloBonoRegalo"
                    style="@style/Socios.SubtituloPanel"
                    tools:text="12–16 oct 2026" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarBono"
                style="@style/Socios.BotonCerrar" />
        </LinearLayout>

        <!-- Activar el ajuste -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActivarBono"
            style="@style/Socios.TarjetaFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                style="@style/Socios.Fila"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/orange_container">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/orange_text" />
                </FrameLayout>

                <LinearLayout
                    style="@style/Socios.ColumnaTextos">

                    <TextView
                        style="@style/Socios.TituloFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bono_switch" />

                    <TextView
                        style="@style/Socios.DescripcionFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bono_switch_detalle" />
                </LinearLayout>

                <!-- Toda la tarjeta lo activa; el interruptor se lee con el título -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchActivarBono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/bono_switch" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/containerBonoConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/bono_modo_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardModoFijo"
                    style="@style/Socios.TarjetaSeleccionable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/Socios.TituloFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bono_modo_fijo" />

                        <TextView
                            style="@style/Socios.DescripcionFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bono_modo_fijo_detalle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardModoSumar"
                    style="@style/Socios.TarjetaSeleccionable"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            style="@style/Socios.TituloFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bono_modo_sumar" />

                        <TextView
                            style="@style/Socios.DescripcionFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bono_modo_sumar_detalle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/bono_label_monto" />

            <!-- Los importes de ImportesPredefinidos.BONUS y "Otro" se añaden desde código -->
            <GridLayout
                android:id="@+id/gridMontos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:columnCount="4" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomMonto"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/bono_hint_monto"
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:startIconDrawable="@drawable/ic_euro">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomMonto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Motivo del ajuste (se muestra en el desglose) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/bono_hint_nota"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:startIconDrawable="@drawable/ic_notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotaBono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Botones: misma altura y alineados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarBono"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/bono_restablecer"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:fontFamily="@font/geist_semibold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/stroke"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarBono"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1.4"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_save"
                android:textSize="15sp"
                android:fontFamily="@font/geist_semibold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
