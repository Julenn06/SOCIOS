<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    tools:context=".MainActivity"
    tools:targetApi="q">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_app_bar"
            app:titleTextAppearance="@style/Socios.TituloBarra"
            app:titleTextColor="@color/text_main" />

        <!-- Selector de semana: botón "Hoy" a la izquierda en semanas futuras y a la derecha en pasadas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoyLeft"
                style="@style/Socios.BotonHoy"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_left"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Socios.TarjetaFila"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSemanaAnterior"
                        style="@style/Socios.BotonFlecha"
                        android:contentDescription="@string/cd_semana_anterior"
                        app:icon="@drawable/ic_chevron_left" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRangoSemana"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="12 de oct - 16 de oct (2026)" />

                        <TextView
                            android:id="@+id/tvSemanaSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            tools:text="Semana actual" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSemanaSiguiente"
                        style="@style/Socios.BotonFlecha"
                        android:contentDescription="@string/cd_semana_siguiente"
                        app:icon="@drawable/ic_chevron_right" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoyRight"
                style="@style/Socios.BotonHoy"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="end" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="88dp">

            <!-- Resumen de la semana -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:outlineAmbientShadowColor="@color/header_gradient_start"
                android:outlineSpotShadowColor="@color/header_gradient_start"
                app:cardCornerRadius="28dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/header_filo"
                app:strokeWidth="1dp"
                tools:targetApi="p">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- El neto: al tocarlo se apuntan las devoluciones de la semana -->
                        <LinearLayout
                            android:id="@+id/containerNetoHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-6dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:id="@+id/tvNetoHeaderLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/header_neto_semanal"
                                android:textColor="@color/header_label_neto"
                                android:textSize="13sp"
                                android:fontFamily="@font/geist_medium" />

                            <TextView
                                android:id="@+id/tvNetoHeader"
                                style="@style/Socios.CifraGrande"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@android:color/white"
                                android:textSize="44sp"
                                tools:text="424,01 €" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerDesglose"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:minHeight="40dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/action_ver_irpf"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:fontFamily="@font/geist_semibold"
                            app:backgroundTint="#1FFFFFFF"
                            app:cornerRadius="999dp"
                            app:strokeColor="@color/header_filo"
                            app:strokeWidth="1dp"
                            app:icon="@drawable/ic_receipt"
                            app:iconSize="18dp"
                            app:iconTint="@android:color/white" />
                    </LinearLayout>

                    <!-- Base, bonus (se puede ajustar) e IRPF -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_caja_translucida"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/label_base_x2"
                                android:textColor="@color/header_label_base"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tvBaseHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:fontFamily="@font/geist_semibold"
                                tools:text="+400 €" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/containerBonusHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_caja_translucida"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvBonusHeaderLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:maxLines="1"
                                android:textColor="@color/header_label_bonus"
                                android:textSize="11.5sp"
                                app:drawableEndCompat="@drawable/ic_edit_pequeno"
                                app:drawableTint="@color/header_label_bonus"
                                tools:text="Bonus" />

                            <TextView
                                android:id="@+id/tvBonusHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/header_bonus"
                                android:textSize="16sp"
                                android:fontFamily="@font/geist_semibold"
                                tools:text="+140 €" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_caja_translucida"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvIrpfHeaderLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/header_label_irpf"
                                android:textSize="11.5sp"
                                tools:text="IRPF 21,48 %" />

                            <TextView
                                android:id="@+id/tvIrpfHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="@color/header_irpf"
                                android:textSize="16sp"
                                android:fontFamily="@font/geist_semibold"
                                tools:text="-115,99 €" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Devoluciones: lo descontado esta semana por cuotas devueltas, antes del IRPF -->
                    <LinearLayout
                        android:id="@+id/containerDevolucionesHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_caja_translucida"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_devolucion"
                            app:tint="@color/header_label_devoluciones" />

                        <TextView
                            android:id="@+id/tvDevolucionesHeaderLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/label_devoluciones"
                            android:textColor="@color/header_label_devoluciones"
                            android:textSize="12.5sp"
                            tools:text="Devoluciones · 2.ª cuota de Ana" />

                        <TextView
                            android:id="@+id/tvDevolucionesHeader"
                            style="@style/Socios.Cifra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/header_devoluciones"
                            android:textSize="15sp"
                            tools:text="−24,00 €" />

                        <ImageView
                            android:id="@+id/ivDevolucionesHeaderIcono"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit_pequeno"
                            app:tint="@color/header_label_devoluciones" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aviso de socios pendientes en semanas anteriores: lleva a revisarlos; la ✕ lo oculta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisoPendientes"
                style="@style/Socios.TarjetaFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/amber_container"
                app:strokeColor="@color/amber_stroke"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_ambar">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pendientes"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAvisoPendientes"
                            style="@style/Socios.TituloFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/amber_text"
                            tools:text="3 pendientes de semanas anteriores" />

                        <TextView
                            style="@style/Socios.DescripcionFila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pendientes_aviso_detalle" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOcultarAvisoPendientes"
                        style="@style/Socios.BotonAccionSocio"
                        android:contentDescription="@string/cd_ocultar_aviso_pendientes"
                        app:icon="@drawable/ic_close"
                        app:iconTint="@color/amber_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progreso del bonus por tramos -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Socios.TarjetaFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icono_ambar">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_trophy"
                                app:tint="@android:color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBonusTitle"
                                style="@style/Socios.TituloFila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Bonus de la semana: +100 €" />

                            <TextView
                                android:id="@+id/tvBonusSiguienteMeta"
                                style="@style/Socios.DescripcionFila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="¡Haz 3 socios más para el bonus de +140 €!" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBonusProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pastilla_version"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/on_primary_container"
                            android:textSize="12sp"
                            android:fontFamily="@font/geist_semibold"
                            tools:text="7 / 10" />
                    </LinearLayout>

                    <com.julen.socios.ProgresoBonusView
                        android:id="@+id/progressBonus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filtro por día: Todos y los cinco días, con cuántos socios hay en cada uno -->
            <TextView
                style="@style/Socios.Seccion"
                android:text="@string/filtro_dias_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleFiltroDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnFiltroTodos"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroTodos"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    tools:text="Todos\n7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroLun"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Lun\n2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroMar"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mar\n1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroMie"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mié\n0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroJue"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Jue\n3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroVie"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Vie\n1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Encabezado de la lista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvListaTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_main"
                    android:textSize="19sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="Socios de la semana" />

                <TextView
                    android:id="@+id/tvListaResumenDia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pastilla_version"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="5 de 7 hechos" />
            </LinearLayout>

            <!-- Estado vacío: una tarjeta compacta (para que no quede bajo el botón flotante) que abre el formulario -->
            <LinearLayout
                android:id="@+id/containerEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible"
                android:background="@drawable/bg_vacio"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_vacio"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:stateListAnimator="@animator/pulsar">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/primary_container">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_group"
                        app:tint="@color/primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Socios.TituloFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_titulo" />

                    <TextView
                        style="@style/Socios.DescripcionFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_mensaje" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSocios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layoutAnimation="@anim/layout_animation_fall_down"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_socio" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddSocio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/fab_nuevo_socio"
        android:textColor="@color/on_primary"
        android:fontFamily="@font/geist_semibold"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary"
        app:shapeAppearanceOverlay="@style/Socios.FormaFab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
