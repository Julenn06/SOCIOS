<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal con estilo de libro de cuentas: todo sobre el papel, sin tarjetas de color. El neto en
     grande y en serif, debajo las tres columnas que lo forman, el bonus, el filtro por día y los socios en
     filas separadas por líneas finas. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:forceDarkAllowed="false"
    tools:context=".MainActivity"
    tools:targetApi="q">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:title="@string/title_app_bar"
            app:titleTextAppearance="@style/Socios.TituloBarra"
            app:titleTextColor="@color/text_main" />

        <!-- Selector de semana: botón "Hoy" a la izquierda en semanas futuras y a la derecha en pasadas -->
        <LinearLayout
            android:id="@+id/filaSemana"
            style="@style/Socios.Fila"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoyLeft"
                style="@style/Socios.BotonHoy"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSemanaAnterior"
                style="@style/Socios.BotonFlecha"
                android:contentDescription="@string/cd_semana_anterior"
                app:icon="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="2dp">

                <!-- Con la letra grande del sistema se encoge en vez de partir la fecha en dos líneas -->
                <TextView
                    android:id="@+id/tvRangoSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="17sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/geist_semibold"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:textColor="@color/text_main"
                    android:textSize="17sp"
                    tools:text="26–30 oct" />

                <!-- Un punto del color del momento (verde la actual, gris las pasadas, azul las futuras) -->
                <LinearLayout
                    android:id="@+id/filaSubtituloSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/puntoSemana"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_circulo"
                        android:backgroundTint="@color/primary" />

                    <TextView
                        android:id="@+id/tvSemanaSubtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/geist_medium"
                        android:maxLines="1"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Semana actual" />
                </LinearLayout>

                <!-- Ocupa lo que necesita, o el ancho que haya si no cabe -->
                <com.julen.socios.FranjaSemanaView
                    android:id="@+id/franjaSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSemanaSiguiente"
                style="@style/Socios.BotonFlecha"
                android:contentDescription="@string/cd_semana_siguiente"
                app:icon="@drawable/ic_chevron_right" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoyRight"
                style="@style/Socios.BotonHoy"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            style="@style/Socios.Regla"
            android:layout_marginHorizontal="20dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="96dp">

            <!-- El neto: con un doble toque se ajusta a lo cobrado de verdad -->
            <LinearLayout
                android:id="@+id/containerNetoHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvNetoHeaderLabel"
                    style="@style/Socios.Rotulo"
                    android:text="@string/header_neto_semanal" />

                <!-- Con la letra grande del sistema la cifra se encoge en vez de partirse por la coma -->
                <TextView
                    android:id="@+id/tvNetoHeader"
                    style="@style/Socios.CifraSerif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autoSizeMaxTextSize="68sp"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textSize="68sp"
                    tools:text="424,01 €" />
            </LinearLayout>

            <!-- Base, bonus (se puede ajustar) e IRPF, como tres columnas de un libro de cuentas. Las que se
                 tocan no llevan el resalte estándar: al tocarlas se encogen un poco y vibran (ver MainActivity). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Socios.CeldaCifra">

                    <TextView
                        style="@style/Socios.EtiquetaCajaCabecera"
                        android:text="@string/label_base_x2"
                        android:textColor="@color/text_sub" />

                    <TextView
                        android:id="@+id/tvBaseHeader"
                        style="@style/Socios.ImporteCelda"
                        tools:text="+400 €" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerBonusHeader"
                    style="@style/Socios.CeldaCifra"
                    android:layout_marginHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvBonusHeaderLabel"
                        style="@style/Socios.EtiquetaCajaCabecera"
                        android:drawablePadding="4dp"
                        android:textColor="@color/text_sub"
                        app:drawableEndCompat="@drawable/ic_edit_pequeno"
                        app:drawableTint="@color/text_sub"
                        tools:text="Bonus" />

                    <TextView
                        android:id="@+id/tvBonusHeader"
                        style="@style/Socios.ImporteCelda"
                        android:textColor="@color/amber_text"
                        tools:text="+140 €" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Socios.CeldaCifra">

                    <!-- "IRPF 21,48 %" es la etiqueta más larga: con la letra grande encoge en vez de cortarse -->
                    <TextView
                        android:id="@+id/tvIrpfHeaderLabel"
                        style="@style/Socios.EtiquetaCajaCabecera"
                        android:layout_width="match_parent"
                        android:autoSizeMaxTextSize="10.5sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="@color/text_sub"
                        tools:text="IRPF 21,48 %" />

                    <TextView
                        android:id="@+id/tvIrpfHeader"
                        style="@style/Socios.ImporteCelda"
                        android:textColor="@color/red_text"
                        tools:text="-115,99 €" />
                </LinearLayout>
            </LinearLayout>

            <!-- Solo con el neto ajustado a lo cobrado: cuánto se ha descontado de lo calculado -->
            <LinearLayout
                android:id="@+id/containerCobroHeader"
                style="@style/Socios.Fila"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_regla_superior"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="44dp"
                android:paddingTop="10dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cobro"
                    app:tint="@color/orange_text" />

                <TextView
                    android:id="@+id/tvCobroHeaderLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/header_cobro_descontado"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Te han descontado" />

                <TextView
                    android:id="@+id/tvCobroHeader"
                    style="@style/Socios.Cifra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/orange_text"
                    android:textSize="15sp"
                    tools:text="-15,31 €" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit_pequeno"
                    app:tint="@color/text_sub" />
            </LinearLayout>

            <!-- Aviso de socios pendientes en semanas anteriores: una franja fina que lleva a revisarlos; la ✕
                 lo oculta hasta que haya otro. Fina para no quitarle sitio a la semana que se está viendo. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisoPendientes"
                style="@style/Socios.TarjetaFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/amber_container"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    style="@style/Socios.Fila"
                    android:paddingStart="14dp"
                    android:paddingEnd="2dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pendientes"
                        app:tint="@color/amber_text" />

                    <TextView
                        android:id="@+id/tvAvisoPendientes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/geist_medium"
                        android:paddingVertical="6dp"
                        android:textColor="@color/amber_text"
                        android:textSize="14sp"
                        tools:text="3 pendientes de semanas anteriores" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOcultarAvisoPendientes"
                        style="@style/Socios.BotonAccionSocio"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_ocultar_aviso_pendientes"
                        app:icon="@drawable/ic_close"
                        app:iconSize="16dp"
                        app:iconTint="@color/amber_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progreso del bonus por tramos -->
            <View
                style="@style/Socios.Regla"
                android:layout_marginTop="28dp" />

            <LinearLayout
                style="@style/Socios.Fila"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/tvBonusTitle"
                    style="@style/Socios.TituloFila"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    tools:text="Bonus de la semana: +100 €" />

                <!-- El marco se queda quieto y el número rueda dentro (recortado a su forma) al cambiar.
                     Con ancho mínimo y cifras de igual ancho, "3 / 5" y "6 / 7" miden lo mismo. -->
                <FrameLayout
                    android:id="@+id/pastillaBonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_marco_cifra"
                    android:minWidth="52dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvBonusProgressCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/geist_semibold"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/text_main"
                        android:textSize="12.5sp"
                        tools:text="7 / 10" />
                </FrameLayout>
            </LinearLayout>

            <com.julen.socios.ProgresoBonusView
                android:id="@+id/progressBonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <View
                style="@style/Socios.Regla"
                android:layout_marginTop="20dp" />

            <!-- Filtro por día: Todos y los cinco días, con cuántos socios hay en cada uno -->
            <TextView
                style="@style/Socios.Seccion"
                android:layout_marginTop="22dp"
                android:text="@string/filtro_dias_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleFiltroDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnFiltroTodos"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroTodos"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.25"
                    tools:text="Todos\n7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroLun"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Lun\n2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroMar"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mar\n1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroMie"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Mié\n0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroJue"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Jue\n3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroVie"
                    style="@style/Socios.OpcionFiltro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Vie\n1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Encabezado de la lista -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvListaTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/instrument_serif"
                    android:letterSpacing="-0.01"
                    android:textColor="@color/text_main"
                    android:textSize="28sp"
                    tools:text="Socios de la semana" />

                <TextView
                    android:id="@+id/tvListaResumenDia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/text_sub"
                    android:textSize="12.5sp"
                    tools:text="5 de 7 hechos" />
            </LinearLayout>

            <!-- Estado vacío: un hueco compacto (para que no quede bajo el botón flotante) que abre el formulario -->
            <LinearLayout
                android:id="@+id/containerEmptyState"
                style="@style/Socios.Fila"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_vacio"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_vacio"
                android:padding="16dp"
                android:stateListAnimator="@animator/pulsar"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/surface_muted">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_group"
                        app:tint="@color/text_main" />
                </FrameLayout>

                <LinearLayout
                    style="@style/Socios.ColumnaTextos">

                    <TextView
                        style="@style/Socios.TituloFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_titulo" />

                    <TextView
                        style="@style/Socios.DescripcionFila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_mensaje" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_main" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSocios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layoutAnimation="@anim/layout_animation_fall_down"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_socio" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- "Nuevo socio" en tinta: la única pieza oscura y sólida de la pantalla -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddSocio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:fontFamily="@font/geist_semibold"
        android:text="@string/fab_nuevo_socio"
        android:textColor="@color/bg_light"
        app:backgroundTint="@color/text_main"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/bg_light"
        app:rippleColor="#33FFFFFF"
        app:shapeAppearanceOverlay="@style/Socios.FormaFab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
