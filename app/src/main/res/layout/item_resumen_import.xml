<?xml version="1.0" encoding="utf-8"?>
<!-- Una línea del resumen de importación: icono en su placa y el texto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <FrameLayout
        android:id="@+id/placaResumen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icono_tile"
        tools:backgroundTint="@color/green_container">

        <ImageView
            android:id="@+id/ivResumen"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_person"
            tools:tint="@color/green_text_soft" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        tools:text="12 socios nuevos" />
</LinearLayout>
