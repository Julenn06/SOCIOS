<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila del histórico: placa con la semana, el mes o el año; resumen; neto e IRPF. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Socios.TarjetaFila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <LinearLayout
        style="@style/Socios.Fila"
        android:baselineAligned="false"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icono_tile"
            android:backgroundTint="@color/blue_container">

            <TextView
                android:id="@+id/tvSemanaItemEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/blue_text_soft"
                android:textSize="13sp"
                android:fontFamily="@font/geist_semibold"
                tools:text="S42" />
        </FrameLayout>

        <LinearLayout
            style="@style/Socios.ColumnaTextos">

            <TextView
                android:id="@+id/tvSemanaItemTitulo"
                style="@style/Socios.TituloFila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="12–16 oct 2026" />

            <TextView
                android:id="@+id/tvSemanaItemSociosCount"
                style="@style/Socios.DescripcionFila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="8 socios hechos (+100 € bonus)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSemanaItemNeto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_text_soft"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                tools:text="+324,50 €" />

            <TextView
                android:id="@+id/tvSemanaItemIrpf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/red_text"
                android:textSize="11.5sp"
                tools:text="IRPF -88,70 €" />
        </LinearLayout>

        <!-- Solo en las semanas, que se pueden abrir -->
        <ImageView
            android:id="@+id/ivSemanaItemFlecha"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_sub" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
