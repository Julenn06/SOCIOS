<?xml version="1.0" encoding="utf-8"?>
<!-- Un socio de la lista, en una sola fila: placa del importe, nombre con día y estado, y a la derecha
     el interruptor que lo marca como conseguido. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Socios.TarjetaFila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <!-- Placa del importe: el fondo (verde o ámbar según el estado) se pone desde código. Tamaño mínimo
             y no fijo, para que con la letra grande del sistema crezca en lugar de cortar el importe. -->
        <LinearLayout
            android:id="@+id/placaImporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:minHeight="60dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvColaboracionAmount"
                style="@style/Socios.Cifra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                tools:text="20 €" />

            <TextView
                android:id="@+id/tvBaseX2Amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                tools:text="40 € base" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreSocio"
                style="@style/Socios.TituloFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                tools:text="Juan Pérez" />

            <!-- Día y estado: "Jueves · Suma 40 €" o "Martes · Pendiente" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDiaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_medium"
                    android:maxLines="1"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Jueves" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/separador_punto"
                    android:textColor="@color/stroke"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEstadoTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/geist_semibold"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textSize="13sp"
                    tools:text="Suma 40 €"
                    tools:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="Firma realizada en punto presencial" />
        </LinearLayout>

        <!-- Solo el interruptor cambia el estado. Tocar la tarjeta la edita y mantenerla pulsada ofrece
             editar o eliminar (con confirmación y opción de deshacer). -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHecho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/item_switch_hecho"
            android:minHeight="48dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
