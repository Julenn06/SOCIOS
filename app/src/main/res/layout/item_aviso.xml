<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso flotante: franja e icono del color de su tipo, título y detalle, un botón de acción si hay, la ✕
     para cerrarlo y abajo una barra fina que se va vaciando con el tiempo que le queda. Se cierra también
     tocándolo o deslizándolo hacia un lado (ver Avisos). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:rippleColor="@android:color/transparent"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Socios.Fila"
            android:minHeight="64dp">

            <View
                android:id="@+id/franjaAviso"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                tools:background="@color/primary" />

            <FrameLayout
                android:id="@+id/placaAviso"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginVertical="12dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icono_tile"
                tools:backgroundTint="@color/green_container">

                <ImageView
                    android:id="@+id/ivAviso"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_check_circle"
                    tools:tint="@color/green_text_soft" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:layout_marginVertical="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_main"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/geist_semibold"
                    tools:text="Socio añadido" />

                <TextView
                    android:id="@+id/tvDetalleAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Ana López · Martes"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccionAviso"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/on_primary_container"
                android:textSize="13.5sp"
                android:fontFamily="@font/geist_semibold"
                android:visibility="gone"
                app:backgroundTint="@color/primary_container"
                app:cornerRadius="12dp"
                tools:text="Deshacer"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarAviso"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/cd_cerrar_aviso"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconSize="18dp"
                app:iconTint="@color/text_sub" />
        </LinearLayout>

        <!-- Tiempo que le queda: se vacía de derecha a izquierda -->
        <View
            android:id="@+id/barraTiempoAviso"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            tools:background="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
