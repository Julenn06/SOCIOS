<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de un día en la lista de socios: el día y cuántos están hechos y cuánto suman. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvCabeceraDia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/geist_semibold"
        android:importantForAccessibility="no"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        tools:text="Martes" />

    <TextView
        android:id="@+id/tvCabeceraDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_medium"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:textColor="@color/text_sub"
        android:textSize="12.5sp"
        tools:text="2 de 3 · +80 €" />
</LinearLayout>
