<?xml version="1.0" encoding="utf-8"?>
<!-- Al mantener pulsado un socio: quién es (importe, nombre, día y estado) y qué se puede hacer con él. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:forceDarkAllowed="false"
    tools:targetApi="q">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View style="@style/Socios.AsaPanel" />

        <!-- El socio, con la misma placa que su fila de la lista -->
        <LinearLayout
            style="@style/Socios.Fila"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/placaAcciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="3dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvImporteAcciones"
                    style="@style/Socios.Cifra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    tools:text="15 €" />

                <TextView
                    android:id="@+id/tvBaseAcciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp"
                    tools:text="30 € base" />
            </LinearLayout>

            <LinearLayout style="@style/Socios.ColumnaTextos">

                <TextView
                    android:id="@+id/tvNombreAcciones"
                    style="@style/Socios.TituloPanel"
                    android:layout_width="match_parent"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:targetApi="p"
                    tools:text="Asier" />

                <TextView
                    android:id="@+id/tvSemanaAcciones"
                    style="@style/Socios.SubtituloPanel"
                    tools:text="Lunes · 26–30 oct" />

                <TextView
                    android:id="@+id/tvEstadoAcciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pastilla_version"
                    android:fontFamily="@font/geist_semibold"
                    android:fontFeatureSettings="tnum"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="12sp"
                    tools:text="Suma 30 €" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotasAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_nota"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Firma realizada en punto presencial"
            tools:visibility="visible" />

        <TextView
            style="@style/Socios.Seccion"
            android:layout_marginTop="22dp"
            android:text="@string/socio_acciones_seccion" />

        <include
            android:id="@+id/accionEditar"
            layout="@layout/item_formato" />

        <include
            android:id="@+id/accionEliminar"
            layout="@layout/item_formato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
