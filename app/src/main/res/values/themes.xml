    </style>
    <style name="TextAppearance.Socios.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.Socios.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.Socios.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.Socios.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>
    <style name="TextAppearance.Socios.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/geist</item>
