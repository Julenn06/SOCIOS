<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema claro y oscuro (sigue al sistema). Los colores cambian solos con values-night/colors.xml. -->
    <style name="Base.Theme.Socios" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- El tema oscuro es propio: que el sistema no oscurezca la app por su cuenta. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Sin el tinte verdoso que Material añade a lo que tiene sombra (avisos, tarjetas elevadas). -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Geist en toda la app: en los TextView sueltos y en la escala de Material (botones, campos, diálogos). -->
        <!-- Solo android:fontFamily: el fontFamily de AppCompat a nivel de tema pisaría el peso que cada
             vista pide con android:fontFamily (geist_semibold…). -->
        <item name="android:fontFamily">@font/geist</item>
        <!-- Números de ancho fijo: las cifras de importes y contadores no bailan al cambiar. -->
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Socios.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Socios.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Socios.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Socios.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Socios.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Socios.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Socios.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Socios.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Socios.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Socios.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Socios.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Socios.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Socios.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Socios.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Socios.LabelSmall</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorPrimaryInverse">@color/primary_inverse</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnSurfaceVariant">@color/text_sub</item>
        <item name="colorSurfaceContainerLow">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card</item>
        <item name="colorSurfaceContainerHighest">@color/surface_card</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Socios.Dialogo</item>
    </style>

    <!-- Diálogos con el título en negrita, como los paneles. -->
    <style name="ThemeOverlay.Socios.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Socios.Dialogo.Titulo</item>
        <!-- Sin el tinte verdoso de la elevación, igual que en los paneles. -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Socios.Dialogo.Titulo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="fontFamily">@font/geist_semibold</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
        <!-- Sin el tinte verdoso que Material añade según la elevación: el panel es surface_card tal cual. -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Escala tipográfica de Material con Geist. -->
    <style name="TextAppearance.Socios.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/geist</item>
        <item name="fontFamily">@font/geist</item>
    </style>
