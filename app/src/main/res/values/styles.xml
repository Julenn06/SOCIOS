<?xml version="1.0" encoding="utf-8"?>
<!-- Piezas comunes de los paneles: panel "Más", exportar/importar y formulario del socio. -->
<resources>

    <!-- Fila horizontal con los elementos centrados en vertical: cabeceras, filas de tarjetas y del desglose. -->
    <style name="Socios.Fila" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Título y descripción junto a una placa o un icono: ocupan el ancho que queda en la fila. -->
    <style name="Socios.ColumnaTextos" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Cabecera de los paneles: asa para arrastrar, placa de color con su icono, título y subtítulo. -->
    <style name="Socios.AsaPanel" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@color/handle</item>
    </style>

    <style name="Socios.PlacaPanel" parent="">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="Socios.IconoPanel" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="Socios.TituloPanel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
    </style>

    <style name="Socios.SubtituloPanel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Título pequeño de sección ("Formato", "Apariencia"…), en tipo frase y en semibold. -->
    <style name="Socios.Seccion" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13.5sp</item>
    </style>

    <!-- Cifras: semibold, con números de ancho fijo para que no bailen al cambiar. -->
    <style name="Socios.Cifra" parent="">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Cifra principal de una cabecera (neto de la semana, ganancia del socio…). -->
    <style name="Socios.CifraGrande" parent="Socios.Cifra">
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Fila grande y pulsable: placa con icono, título, descripción y flecha. -->
    <style name="Socios.TarjetaFila" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_muted</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/pulsar</item>
    </style>

    <!-- Tarjeta que se elige entre varias (alcance de la exportación, tema, estado del socio). -->
    <style name="Socios.TarjetaSeleccionable" parent="Widget.Material3.CardView.Outlined">
        <item name="android:checkable">true</item>
        <item name="cardBackgroundColor">@color/tarjeta_fondo</item>
        <!-- Sin la capa azulada que Material pone encima al marcarla: el color lo da cardBackgroundColor. -->
        <item name="cardForegroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="android:stateListAnimator">@animator/pulsar</item>
        <item name="strokeColor">@color/tarjeta_borde</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="checkedIcon">@drawable/ic_check_circle</item>
        <item name="checkedIconTint">@color/primary</item>
        <item name="checkedIconSize">20dp</item>
        <item name="checkedIconMargin">8dp</item>
    </style>

    <!-- Botón-opción con estado (cuotas, días): verde relleno cuando está elegido. -->
    <style name="Socios.Opcion" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:checkable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/opcion_texto</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="backgroundTint">@color/opcion_fondo</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/opcion_borde</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Opción del filtro por día: el día y, debajo, cuántos socios hay. -->
    <style name="Socios.OpcionFiltro" parent="Socios.Opcion">
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Título de la barra superior. -->
    <style name="Socios.TituloBarra" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="fontFamily">@font/geist_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textSize">23sp</item>
    </style>

    <!-- Botón redondo de icono, con el icono centrado: los de Material reservan un hueco a la izquierda
         que lo descentra cuando el botón no tiene su tamaño original. -->
    <style name="Socios.BotonIcono" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/surface_muted</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:stateListAnimator">@animator/pulsar</item>
    </style>

    <!-- Lápiz y papelera de cada socio: sin placa, solo el icono, con zona táctil de 40 dp. -->
    <style name="Socios.BotonAccionSocio" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Flechas del selector de semana. -->
    <style name="Socios.BotonFlecha" parent="Socios.BotonIcono">
        <item name="iconTint">@color/text_main</item>
    </style>

    <!-- Botón para volver a la semana actual: de la altura y con las esquinas de la tarjeta del selector, en el verde
         de "Semana actual", con el calendario encima de "Hoy". El lado en el que sale ya dice hacia dónde queda. -->
    <style name="Socios.BotonHoy" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:text">@string/btn_hoy</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="cornerRadius">20dp</item>
        <item name="icon">@drawable/ic_today</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:stateListAnimator">@animator/pulsar</item>
    </style>

    <!-- Botón flotante de "Nuevo socio", con las esquinas de las tarjetas. -->
    <style name="Socios.FormaFab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Botón ✕ para cerrar un panel, arriba a la derecha. -->
    <style name="Socios.BotonCerrar" parent="Socios.BotonIcono">
        <item name="android:contentDescription">@string/action_close</item>
        <item name="icon">@drawable/ic_close</item>
        <item name="iconTint">@color/text_sub</item>
    </style>

    <!-- Filas del desglose: punto de color, concepto e importe (cada fila, con Socios.Fila). -->
    <style name="Socios.PuntoCalculo" parent="">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:background">@drawable/bg_circulo</item>
    </style>

    <style name="Socios.EtiquetaCalculo" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Socios.ImporteCalculo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Título y descripción dentro de las filas y tarjetas. -->
    <style name="Socios.TituloFila" parent="">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Socios.DescripcionFila" parent="">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Pastilla con un dato corto sobre la cabecera verde ("28 semanas"). -->
    <style name="Socios.PastillaCabecera" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pastilla</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
    </style>

    <!-- Caja translúcida con una cifra en la cabecera verde: tres en fila, del mismo ancho. -->
    <style name="Socios.CajaCabecera" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_caja_translucida</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Socios.EtiquetaCajaCabecera" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <!-- La cifra encoge lo justo para caber entera: "+10.044,14 €" no debe cortarse. -->
    <style name="Socios.ImporteCajaCabecera" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/geist_semibold</item>
    </style>

    <!--
        Barra que muestra una parte de un total (0 a 1000), de una pieza: la de Material 3 deja un hueco y un
        punto al final. El grosor (alto) y los colores (progressTint y progressBackgroundTint) van en cada una.
    -->
    <style name="Socios.BarraProporcion" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:indeterminate">false</item>
        <item name="android:max">1000</item>
        <item name="android:progressDrawable">@drawable/barra_proporcion</item>
    </style>
</resources>
