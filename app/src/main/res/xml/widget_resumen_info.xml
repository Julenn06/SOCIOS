<?xml version="1.0" encoding="utf-8"?>
<!-- Widget con el resumen de la semana actual. Se actualiza al cambiar los datos en la app y, para pasar
     solo a la semana nueva el lunes, cada media hora (el mínimo que permite Android). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_descripcion"
    android:initialLayout="@layout/widget_resumen"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_resumen"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
