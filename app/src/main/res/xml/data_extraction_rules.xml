<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: copia en la nube y transferencia entre dispositivos de la base de datos de socios. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
